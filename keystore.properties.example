# Keystore configuration — copy to keystore.properties and fill in.
# Never commit keystore.properties to version control.
#
# Environment variable overrides (CI/CD):
#   PSWD_MNGR_KEYSTORE        path to the keystore file
#   PSWD_MNGR_KEYSTORE_PASS   keystore password
#   PSWD_MNGR_KEY_ALIAS       key alias
#   PSWD_MNGR_KEY_PASS        key password

storeFile=release-keystore.jks
storePassword=your-keystore-password-here
keyAlias=your-key-alias-here
keyPassword=your-key-password-here
